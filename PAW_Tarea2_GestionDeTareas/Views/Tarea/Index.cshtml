@{
    ViewBag.Title = "Mis tareas";
}

<main>
    <div id="tareasApp"
         data-url-sincronizar="@Url.Action("Sincronizar", "Tarea")"
         data-url-crear="@Url.Action("Crear", "Tarea")"
         data-url-editar="@Url.Action("Editar", "Tarea")"
         data-url-estado="@Url.Action("CambiarEstado", "Tarea")"
         data-url-eliminar="@Url.Action("Eliminar", "Tarea")">

        <h2>Mis tareas</h2>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Agregar o editar tarea</h3>
            </div>

            <div class="panel-body">
                <form id="formTarea">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="tareaId" />

                    <div class="form-group">
                        <label for="titulo">Título</label>
                        <input type="text"
                               id="titulo"
                               class="form-control"
                               maxlength="100"
                               required />
                    </div>

                    <div class="form-group">
                        <label for="descripcion">Descripción</label>
                        <textarea id="descripcion"
                                  class="form-control"
                                  maxlength="1000"
                                  rows="4"></textarea>
                    </div>

                    <button type="submit"
                            id="botonGuardar"
                            class="btn btn-primary">
                        Agregar tarea
                    </button>

                    <button type="button"
                            id="botonCancelar"
                            class="btn btn-secondary"
                            hidden>
                        Cancelar edición
                    </button>
                </form>
            </div>
        </div>

        <p id="mensaje" role="status" aria-live="polite"></p>

        <div class="form-group">
            <label for="filtro">Mostrar:</label>
            <select id="filtro" class="form-control">
                <option value="Todas">Todas</option>
                <option value="Pendientes">Pendientes</option>
                <option value="Completadas">Completadas</option>
            </select>
        </div>

        <ul id="listaTareas" class="list-group"></ul>
    </div>
</main>

@section scripts {
    <script src="@Url.Content("~/Scripts/tareas.js")"></script>
}