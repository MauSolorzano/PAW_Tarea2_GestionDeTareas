
@{
    ViewBag.Title = "Inicio";
}

<style>
    .inicio-container {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        background: linear-gradient(135deg, #f4f7fb, #e8eef8);
        border-radius: 18px;
    }

    .tareas-card {
        width: 100%;
        max-width: 620px;
        padding: 50px 40px;
        text-align: center;
        background-color: #ffffff;
        border-radius: 24px;
        box-shadow: 0 15px 45px rgba(30, 58, 95, 0.12);
        border: 1px solid #e6ebf2;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .tareas-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 55px rgba(30, 58, 95, 0.18);
        }

    .tareas-icono {
        width: 100px;
        height: 100px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8efff;
        color: #3159c9;
        border-radius: 25px;
        font-size: 48px;
    }

    .tareas-card h1 {
        margin-bottom: 18px;
        color: #1e293b;
        font-size: 36px;
        font-weight: 700;
    }


    .btn-tareas {
        display: inline-block;
        padding: 15px 32px;
        color: #ffffff !important;
        background: #3159c9;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none !important;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .btn-tareas:hover {
            background: #2445a5;
            transform: translateY(-2px);
        }


    @@media (max-width: 576px) {
        .tareas-card {
            padding: 35px 22px;
        }

            .tareas-card h1 {
                font-size: 29px;
            }

        .tareas-icono {
            width: 80px;
            height: 80px;
            font-size: 38px;
        }
    }
</style>

<main class="inicio-container">
    <section class="tareas-card" aria-labelledby="tituloTareas">

        <div class="tareas-icono" aria-hidden="true">
            &#9745;
        </div>

        <h1 id="tituloTareas">Gestión de Tareas</h1>


        <a href="@Url.Action("Index", "Tarea")" class="btn-tareas">
            Ir a mis tareas &rarr;
        </a>


    </section>
</main>
